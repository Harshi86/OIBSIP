PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/pizza_app
JWT_SECRET=change_me_to_a_long_random_string
CLIENT_URL=http://localhost:5173

# Razorpay TEST keys: Dashboard -> Account & Settings -> API Keys (test mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Email (leave SMTP_HOST empty to print emails in the server console instead)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM="Pizza Palace <you@gmail.com>"

# Admin account (created by `npm run seed`) + where low-stock alerts go
ADMIN_EMAIL=admin@pizza.com
ADMIN_PASSWORD=Admin@123

# node-cron expression for the low-stock check (default: every 5 minutes)
STOCK_CRON=*/5 * * * *
